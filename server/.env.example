# Production: set these as Wrangler secrets, NOT a .env file.
#   wrangler secret put DATABASE_URL
#   wrangler secret put GOOGLE_CLIENT_ID
#   wrangler secret put GOOGLE_CLIENT_SECRET
#   wrangler secret put TRUSTED_ORIGINS
#
# Local development: create a .dev.vars file (gitignored by Wrangler) with:
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/crabtalk?sslmode=require
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
TRUSTED_ORIGINS=http://localhost:8787,https://your-auth-page.github.io
