{
  "name": "@crabtalk/signal-server",
  "version": "0.1.0",
  "description": "CrabTalk signal server — auth, peer discovery, WebRTC signaling",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "better-auth": "^1.6.13",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.7.0",
    "wrangler": "^4.80.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  }
}
